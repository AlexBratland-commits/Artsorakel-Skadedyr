# Miljøvariabler for Artsorakel.
# Kopier til .env.local for lokal kjøring. I produksjon settes de i Vercel:
# Project → Settings → Environment Variables. Ikke legg ekte verdier i git.

# ── AI-tjenesten (påkrevd) ────────────────────────────────────────────────
# Nøkkel fra openrouter.ai. Sett et kredittak (maks forbruk) på nøkkelen i
# OpenRouter – det er den eneste grensen som virker selv om alt annet svikter.
OPENROUTER_API_KEY=

# Modeller. Endres bare etter godkjenning – standardverdiene er de som er i bruk.
# OPENROUTER_VISION_MODEL=google/gemini-3.7-flash
# OPENROUTER_CHAT_MODEL=openai/gpt-5.6-luna

# Adressen appen ligger på (sendes til OpenRouter som opprinnelse).
# NEXT_PUBLIC_SITE_URL=https://artsorakel.example.no

# ── Tilgang for ansatte ───────────────────────────────────────────────────
# Når satt, må alle skrive inn koden én gang per enhet. Uten den er appen
# åpen, som før. Bruk minst 12 tegn. Flere koder kan skilles med komma, slik
# at en ny kode kan innføres før den gamle fjernes.
# ARTSORAKEL_TILGANGSKODE=

# Hemmelighet for å signere innlogging og chat-billetter. Lag en lang,
# tilfeldig verdi (f.eks. `openssl rand -base64 32`). Uten den avledes en
# nøkkel fra OPENROUTER_API_KEY, og alle blir logget ut når den byttes.
# ARTSORAKEL_HEMMELIGHET=

# ── Upstash Redis (felles tellere) ────────────────────────────────────────
# Gjør at grenser og budsjetter gjelder på tvers av alle serverinstanser.
# Vercel Marketplace-integrasjonen setter KV_REST_API_URL / KV_REST_API_TOKEN
# automatisk; ved oppsett direkte hos Upstash brukes UPSTASH_REDIS_REST_*.
# Er Upstash satt opp, men svarer ikke, avvises nye AI-kall midlertidig med en
# norsk melding (ingen stille reserve i minnet). Uten Upstash-oppsett brukes
# tellere i minnet per instans – bare egnet for lokal utvikling.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Tre lag med vern mot kostnader ────────────────────────────────────────
# 1. ANTALLSGRENSER (under): teller forespørsler. Hindrer misbruk og sikrer
#    rettferdig fordeling, men sier ingenting om hva det koster.
# 2. KOSTNADSRAMME (lenger ned): teller dollar. Stopper AI-kall når dagens
#    faktiske forbruk er nådd.
# 3. KREDITTAK I OPENROUTER: settes i OpenRouter, ikke her. Siste barriere –
#    virker selv om appen har en feil.

# Analyser per time. Standard: 10 per IP uten tilgangskode (som før);
# 20 per enhet og 60 per IP med tilgangskode.
# ARTSORAKEL_ANALYSER_PER_TIME=
# Felles tak for hele appen per døgn (norsk tid). Standard 200.
# ARTSORAKEL_MAKS_ANALYSER_PER_DOGN=200

# Chatspørsmål per time. Standard: 10 per IP uten tilgangskode;
# 30 per enhet og 90 per IP med tilgangskode. Maks 20 spørsmål per analyse.
# ARTSORAKEL_CHAT_PER_TIME=
# ARTSORAKEL_MAKS_CHAT_PER_DOGN=500

# Kostnadsramme per døgn (norsk tid) for alle AI-kall samlet, i USD. Standard 10.
# ARTSORAKEL_MAKS_KOSTNAD_PER_DOGN_USD=10
# Beløp som holdes av før hvert AI-kall og erstattes av faktisk kostnad etterpå.
# Bør ligge over det et vanlig kall koster. Standard 0.02.
# ARTSORAKEL_RESERVASJON_PER_AI_KALL_USD=0.02
# Priser per million tokens, brukt bare hvis OpenRouter ikke oppgir kostnaden i
# svaret. Finnes på modellens side hos OpenRouter. Uten disse – og uten kostnad
# fra OpenRouter – føres reservasjonen som kostnad (forsiktig anslag).
# ARTSORAKEL_PRIS_INN_USD_PER_MTOK=
# ARTSORAKEL_PRIS_UT_USD_PER_MTOK=

# ── Bare for utvikling ────────────────────────────────────────────────────
# Slår av tilgangskode, grenser, kostnadsramme og cache for scripts/eval.mjs.
# OpenRouter-kredittaket gjelder fortsatt.
# Virker bare med `npm run dev`, aldri i produksjon.
# EVAL_MODE=1
